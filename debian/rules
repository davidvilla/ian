#!/usr/bin/make -f
# -*- makefile -*-

VERSION=$(shell head -n 1 debian/changelog | cut -f2 -d " " | tr -d "()" | cut -f1 -d "-")

%:
	dh $@

override_dh_auto_build:
	dh_auto_build
	rst2man ian.rst > ian.1
	rst2man last-pypi-version.rst > last-pypi-version.1
	rst2man version-summary.rst > version-summary.1

override_dh_auto_clean:
	dh_auto_clean
	-$(RM) ian.1 last-pypi-version.1 version-summary.1
