Description: rewrite hardcoded/relative paths to the Debian install location
 unittest.sh and ian.sh locate shell-commodity.sh and the ian-*.sh modules
 relative to the source checkout. Once installed, those files live under
 /usr/share/ian, so the lookup paths must point there instead.
Author: David Villa Alises <David.Villa@gmail.com>
Index: ian/unittest.sh
===================================================================
--- ian.orig/unittest.sh
+++ ian/unittest.sh
@@ -1,5 +1,5 @@

-source shell-commodity.sh
+source /usr/share/ian/shell-commodity.sh

 __file__=$0
 __testname__=$1
Index: ian/ian.sh
===================================================================
--- ian.orig/ian.sh
+++ ian/ian.sh
@@ -61,7 +61,7 @@ __cmd__=$1
 shift
 __args__=("$@")

-IAN_ROOT=$(readlink -f $(dirname $__file__))
+IAN_ROOT=/usr/share/ian
 NATIVE_LANG="$LANG"
 LANG=C

